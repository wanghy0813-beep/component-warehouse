WEB_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
ENABLE_API_DOCS=0

# WXY LAB production uses unified Account SSO only.
AUTH_MODE=account-v1
LOCAL_AUTH_SECRET=replace-with-a-long-random-secret
LOCAL_AUTH_ALLOW_REGISTRATION=0
ADMIN_PHONE_NUMBERS=

# Unified Account V1 service and SSO settings.
ACCOUNT_PROVIDER_LABEL=Account V1
ACCOUNT_BASE_URL=https://wxylab.ltd/api/wxylab/account/v1
ACCOUNT_SERVICE_CLIENT_ID=componentwarehouse-service
ACCOUNT_WEB_CLIENT_ID=componentwarehouse-web
ACCOUNT_DESKTOP_CLIENT_ID=componentwarehouse-desktop-v1
ACCOUNT_CLIENT_SECRET=
ACCOUNT_SSO_REDIRECT_URI=https://wxylab.ltd/component-warehouse/personal/auth/callback
ACCOUNT_SSO_AUTHORIZE_URL=
ACCOUNT_SSO_TOKEN_URL=

# Public URLs used in QR codes and invite links.
PUBLIC_PERSONAL_BASE_URL=http://localhost:8080/hardware
PUBLIC_TEAM_BASE_URL=http://localhost:8080/component-warehouse/team
TEAM_INVITE_SECRET=replace-with-strong-random-secret

# Open-source default branding.
APP_BRAND_NAME=WXY LAB Hardware
APP_BACKUP_NAME=component-warehouse
APP_SHOW_BRAND_LOGO=1
VITE_BRAND_NAME=WXY LAB Hardware
VITE_BRAND_SHORT=WXY LAB
VITE_BRAND_PERSONAL_TITLE=WXY LAB Hardware · 个人硬件研发工作台
VITE_BRAND_TEAM_TITLE=WXY LAB Hardware Workspace · 团队版暂停维护
VITE_BRAND_SHOW_LOGO=1
VITE_PWA_PERSONAL_NAME=WXY LAB Hardware
VITE_PWA_TEAM_NAME=WXY LAB Hardware Workspace 团队版
VITE_COPYRIGHT_TEXT=© 2026 WXY LAB
# WXY LAB deployment filing records. Override these for other deployments.
VITE_ICP_RECORD_TEXT=ICP 备案号：冀ICP备2026009111号-1
VITE_ICP_RECORD_URL=https://beian.miit.gov.cn/
VITE_PUBLIC_SECURITY_RECORD_TEXT=冀公网安备13010402003414号
VITE_PUBLIC_SECURITY_RECORD_URL=https://beian.mps.gov.cn/#/query/webSearch
VITE_AUTH_IDLE_TIMEOUT_MINUTES=720
VITE_AUTH_MAX_SESSION_HOURS=168

# Open-source default: simple component management, no EDA/AD sync surface.
FEATURE_EDA_ENABLED=0
VITE_FEATURE_EDA_ENABLED=0

# Optional OpenAI-compatible AI endpoint. Leave empty to disable AI-assisted features.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-compatible-model
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=gpt-compatible-model
MIMO_TIMEOUT_SECONDS=90
FOREGROUND_AI_WORKERS=2
AI_WORKER_CONCURRENCY=1
AI_TASK_STUCK_SECONDS=600

# Gerber manufacturing-package parser. Parsing is a persistent single-job queue.
FABRICATION_WORKER_ENABLED=1
FABRICATION_PARSE_TIMEOUT_SECONDS=120
FABRICATION_PARSE_CPU_SECONDS=90
FABRICATION_PARSE_MEMORY_MB=1536
FABRICATION_PARSE_TEMP_MB=768
# Fixed safety limits in the application: ZIP 200MB, expanded 512MB, 500 entries, depth 8.

# Project V2 attachments. Direct-host deployments use an absolute path under /opt/ComponentWarehouse/data.
PROJECT_V2_FILE_ROOT=./data/project-v2-files
RETIRE_LEGACY_PERSONAL_PROJECT_API=1

# Windows desktop synchronization. Keep disabled until the desktop client is
# registered in Account V1 and the initial personal-account rehearsal passes.
SYNC_ENABLED=0
SYNC_ALLOWED_ACCOUNT_IDS=
BACKUP_AUTO_INTERVAL_HOURS=24
BACKUP_MAX_UPLOAD_MB=512
