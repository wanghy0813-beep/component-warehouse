{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WXY LAB Hardware",
  "version": "1.4.0",
  "identifier": "ltd.wxylab.hardware",
  "build": {
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop",
    "frontendDist": "../../frontend/dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WXY LAB Hardware",
        "width": 1440,
        "height": 920,
        "minWidth": 1060,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src http://127.0.0.1:18764 ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/wxy-hardware-api"],
    "resources": {
      "binaries/_internal/": "_internal/"
    },
    "icon": ["../../frontend/src/assets/generated/cw-app-icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./WebView2.FixedVersionRuntime.x64"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
