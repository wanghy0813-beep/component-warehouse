{
  "name": "component-warehouse-frontend",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "rm -rf dist && npm run build:personal && npm run build:team",
    "build:personal": "node scripts/build-target.mjs personal",
    "build:desktop": "node scripts/build-target.mjs desktop",
    "build:team": "node scripts/build-target.mjs team",
    "check:copy": "python3 ../scripts/check_copy.py",
    "test": "npm run test:frontend",
    "test:frontend": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.7.9",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.1",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.5"
  }
}
